# glasscast 本地配置模板
#
# 用法：
#   cp .env.example .env          # .env 已在 .gitignore 里，不会被提交
#   编辑 .env：至少填好 GLASSCAST_PUBLIC_URL 和 GLASSCAST_TOKEN
#   . ./.env && uv run glasscast serve
#
# 说明：
# - glasscast 不会自己读取 .env 文件，要先用 shell 的 `. ./.env`（即 source）把变量导入当前终端。
# - 优先级：命令行参数 > 这里的环境变量 > 代码默认值。空字符串等于没设置。
# - 完整说明见 docs/usage.md 的「环境变量」一节，或运行 uv run glasscast serve --help。
# - 值里不要有空格；含特殊字符时用单引号括起来。

# =========================================================================== 必填

# 对外 HTTPS 根地址（平台云端调 MCP、手机下载图片都用它），末尾不要带 /。
# 必须和平台插件里填的域名完全一致：它决定 start_cast 返回的图片地址，也决定 MCP 放行哪个 Host（不一致会 421）。
# 可以带路径前缀，例如 https://app.example.com/cast（反代剥掉前缀后转发，见 docs/deploy.md）。
export GLASSCAST_PUBLIC_URL=https://cast.example.com

# MCP 的 Bearer Token：平台插件的「认证方式 Bearer Token」里填同一个值（只填 token 本体，不要带 "Bearer "）。
# 留空时每次启动随机生成一个并打印一次，重启后平台里的旧 token 就失效了（表现为 401、工具数为 0），所以请固定它。
# 生成方法（任选一个，把输出粘到等号后面）：
#   openssl rand -hex 24
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# 只能是可见 ASCII 字符，建议至少 16 位。不要写进 SKILL.md、页面、data.json，也不要提交到 git。
export GLASSCAST_TOKEN=

# =========================================================================== 图片地址 key（可选）

# 图片地址 https://<域名>/s/<KEY>/screen.jpg 里的随机段，眼镜发不了请求头，图片只靠它保护，相当于「看屏口令」。
# 留空 = 每次启动随机生成 16 位（推荐：眼镜页面用的地址由 start_cast 运行时下发，不需要固定）。
# 只有想让本地模拟器或手工 curl 长期用同一个地址时才固定它；8～128 位字母、数字、- 或 _。
# 生成：openssl rand -hex 12
export GLASSCAST_CAST_KEY=

# =========================================================================== 监听地址

# 只监听本机：公网流量经隧道/反代进来。不要改成 0.0.0.0（会把服务暴露到局域网）。
export GLASSCAST_HOST=127.0.0.1
# deploy/tunnel.sh 默认把服务器上的 127.0.0.1:18766 反向转发到这个端口。
export GLASSCAST_PORT=8766

# =========================================================================== 画面（推荐值，千问 AI 眼镜 S1 真机验证过）

# 输出画布。S1 页面画布是 640x290，但代码默认的 640x290 + 质量 70 的图在真机上下载成功却不显示；
# 480x218 在页面里拉伸到 640x290 显示，真机正常。
export GLASSCAST_CANVAS=480x218
# gray = 8 位灰度：眼镜屏幕是单色绿，颜色本来就显示不出来，灰度图更小。rgb 只作对照。
export GLASSCAST_COLOR_MODE=gray
# crop = 居中裁剪铺满画布（Mac 屏幕比画布高，裁掉上下各一部分）；fit = 等比缩放加黑边。
export GLASSCAST_FIT_MODE=crop
# 每张图尽量不超过 2.6 KB，在这个体积内取能做到的最高质量（JPEG_QUALITY 变成上限）；质量下限 10，文字很密时会超过。
# 真机每张图有约 0.65 s 的固定开销，2.5～4 KB 之间体积对速度影响不大；图太大会不显示。
export GLASSCAST_JPEG_QUALITY=90
export GLASSCAST_JPEG_TARGET_KB=2.6
# auto = 装了 mozjpeg（brew install mozjpeg）就用它，同等观感体积更小；没装就用 Pillow。也可写 mozjpeg / pillow。
export GLASSCAST_JPEG_ENCODER=auto
# 找不到 mozjpeg 时可以指定 cjpeg 的路径（Homebrew 的 mozjpeg 不在 PATH 上，默认会查它的安装位置）。
# export GLASSCAST_MOZJPEG=/opt/homebrew/opt/mozjpeg/bin/cjpeg

# 截哪块屏幕。monitor：1 = 主屏，0 = 所有显示器拼在一起（uv run glasscast monitors 查看）。
# region：只截显示器内的一块区域 左,上,宽,高（相对显示器左上角，macOS 为逻辑点）；none = 全屏。
# 整屏缩到眼镜上字很小，看代码/终端时只投一块区域会清楚很多。
# export GLASSCAST_MONITOR=1
# export GLASSCAST_REGION=0,0,1280,580
# 画面来源：screen 截屏（默认）；synthetic 合成画面（不截屏、不需要屏幕录制权限，联调用）。
# export GLASSCAST_SOURCE=screen

# =========================================================================== 帧率

# 流畅模式（fast）的初始帧率设置，1～10，可带小数；运行中可用「投屏调到 N 帧」或 glasscast set-fps N 修改。
# 注意：这是设置值，不是实际张数；设 4（真机约每秒 1.5 张）是实测的稳定上限，再高可能进入画面卡住不动的状态。
export GLASSCAST_FAST_FPS=4
# 普通模式（image）的截帧频率，默认 1。页面每秒只拉一次，调高只能让拉到的画面更新一点，代价是 CPU。
# export GLASSCAST_IMAGE_FPS=1
# 流畅模式页面每一跳的估计耗时（毫秒，5～500，默认 20），start_cast 据此算出 hops = round(1000/fps/它)。
# export GLASSCAST_EMIT_HOP_MS=20

# =========================================================================== 高级

# 启动后立即开始采集：off（默认，等平台调 start_cast）/ image / fast。
# export GLASSCAST_AUTOSTART=off
# MCP 额外放行的 Host 头（逗号分隔）。public_url 的主机和本机回环已自动放行，一般不用设。
# export GLASSCAST_ALLOWED_HOSTS=
# 设成 0 关闭 MCP 的 Host/Origin 校验（只在反代改写了 Host 又改不了时用），默认 1。
# export GLASSCAST_DNS_REBINDING_PROTECTION=1

# 实验功能：每帧另出一张 N 级灰度 GIF（…/screen.jpg/<任意>.gif），0 = 关闭（默认）。正常投屏用不到。
# export GLASSCAST_GIF_LEVELS=0
# export GLASSCAST_GIF_DELAY_MS=100

# =========================================================================== deploy/tunnel.sh（反向 SSH 隧道，可选）

# 只有用 docs/deploy.md 的反向 SSH 隧道方案时才需要；也可以改用 tunnel.sh 的命令行参数（./deploy/tunnel.sh --help）。
# 用隧道时请取消注释并改成你自己的服务器。
# export GLASSCAST_TUNNEL_HOST=server.example.com
# export GLASSCAST_TUNNEL_USER=ubuntu
# export GLASSCAST_TUNNEL_SSH_PORT=22
# 电脑上 glasscast 的端口，默认跟随 GLASSCAST_PORT。
# export GLASSCAST_LOCAL_PORT=8766
# 服务器上反向转发的端口，要与 deploy/server-setup.sh 的 --tunnel-port 一致。
# export GLASSCAST_REMOTE_PORT=18766
# 每隔多少秒经公网地址请求一次 /healthz，让反代到隧道的长连接保持热态（0 = 关闭，默认 30）。
# export GLASSCAST_WARM_INTERVAL=30
# 保温请求钉到哪个服务器地址：auto（经 DoH 查公网 A 记录，默认）/ 直接写 IP / 空 = 不钉住。
# export GLASSCAST_WARM_RESOLVE=auto
